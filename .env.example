# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et renseigner
# les vraies valeurs. Sans ces variables, le formulaire de contact affiche
# une erreur claire au lieu de planter silencieusement.

# --- Base de données MySQL --------------------------------------------
# Hostinger : hPanel > Bases de données > Bases de données MySQL
#   1. Créer une base + un utilisateur (Hostinger génère souvent un préfixe
#      du type u123456789_).
#   2. DATABASE_HOST est en général "localhost" si l'app tourne sur le même
#      hébergement que la base ; sinon utiliser l'hôte distant fourni par
#      Hostinger.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Envoi d'e-mail (SMTP) ----------------------------------------------
# La boîte mail fournie avec l'hébergement Hostinger fonctionne (hPanel >
# E-mails > Comptes e-mail, puis les identifiants SMTP du compte créé).
# N'importe quel autre fournisseur SMTP standard fonctionne aussi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition (peut être identique à SMTP_USER)
SMTP_FROM="South West Agency <contact@southwestagency.fr>"
# Boîte de l'agence qui reçoit les notifications de nouveau message
CONTACT_NOTIFY_EMAIL=contact@southwestagency.fr
